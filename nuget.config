<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The sample needs only nuget.org. Clearing inherited sources keeps restore from failing on
       unrelated private feeds configured elsewhere on a developer machine. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
