<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Enables `dotnet user-secrets` so the connection string never has to be committed. -->
    <UserSecretsId>cqrsdemo-api-learning-7c2d6f1e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CqrsDemo.Application\CqrsDemo.Application.csproj" />
    <ProjectReference Include="..\CqrsDemo.Infrastructure\CqrsDemo.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Required in the startup project for `dotnet ef` migrations; not shipped as a runtime dependency. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
