# Copy to .env (git-ignored) and replace the placeholder. Never commit .env.
# SA password: 8+ chars, upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=<choose-a-strong-password>
MSSQL_PORT=14330

# Used by the API and EF tools (same value, shell environment variable):
# ConnectionStrings__CatalogDb=Server=localhost,14330;Database=CqrsDemoLearning;User Id=sa;Password=<same-password>;TrustServerCertificate=True
# Integration tests (a unique throwaway database is created and dropped per run):
# CQRSDEMO_TEST_SQLSERVER=Server=localhost,14330;User Id=sa;Password=<same-password>;TrustServerCertificate=True
